pipeline {
    agent {
        docker {
            image 'reka83/maven-chrome'  // Use your custom image with Maven and Chrome
            // Optionally, you can mount Docker socket if Docker CLI commands are needed inside the container:
            // args '-v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        DOCKER_REGISTRY = 'https://index.docker.io/v1/'
        DOCKER_USERNAME = 'reka83'
    }

    stages {
        stage('Login to Docker') {
            steps {
                script {
                    // Login to Docker registry securely
                    sh 'echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin $DOCKER_REGISTRY'
                }
            }
        }
        
        stage('Checkout') {
            steps {
                sh 'echo passed'  // Just for verification
                git branch: 'master', url: 'https://github.com/Rekapost/TestNG_Framework.git'
            }
        }

        stage('Build and Test') {
            steps {
                sh 'mvn clean test -Dsurefire.suiteXmlFiles=testng.xml'  // Run tests with Maven
            }
        }
    }
}



