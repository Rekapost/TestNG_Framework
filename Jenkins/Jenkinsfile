pipeline {
    agent any 

    stages {
        stage('Checkout') {
            steps {
                echo 'Checkout Code from GitHub'
                // Checkout the code from your Git repository
                git branch: 'master', url: 'https://github.com/Rekapost/TestNG_Framework.git'
            }
        }

        stage('Build and Test') {
            steps {
                echo 'Running Maven tests'
                // Run your Maven tests using the testng.xml configuration file
                bat 'mvn clean test -Dsurefire.suiteXmlFiles=testng.xml'  // Adjust if you have a specific testng.xml or configuration
            }
        }

        stage('Post-test Cleanup') {
            steps {
                echo 'Cleaning up after tests'
                // Optional: Run any cleanup or post-test steps if needed
            }
        }

        stage('Static Code Analysis') {
            environment {
                SONAR_URL = "http://localhost:9000"  // Correct base URL without /projects
            }
                steps {
                    withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
                        bat 'mvn clean verify sonar:sonar -Dsonar.host.url=${SONAR_URL} -Dsonar.login=$SONAR_AUTH_TOKEN'
                    }
                }
            }

    }

    post {
        success {
            echo 'Tests passed successfully!'
        }
        failure {
            echo 'Tests failed, please check the logs.'
        }
    }
}



