pipeline {

  //agent any  // Use any available agent (Linux in this case)
agent {
    docker {
      image 'maven:3.8.5-jdk-11'  // Official Maven image with Java 11
    }
  }

/*tools {
    maven 'Maven'  // Use the Maven installation configured in Jenkins
  }
*/ 
  stages {

    stage('Checkout') {
      steps {
        sh 'echo passed'  // Use 'sh' if on Linux , 'bat' if on Windows 
        git branch: 'master', url: 'https://github.com/Rekapost/TestNG_Framework.git'
      }
    }

    stage('Build and Test') {
      steps {
        sh 'mvn clean test -Dsurefire.suiteXmlFiles=testng.xml'  // Use 'sh' if on Linux
      }
    }
  }
}


