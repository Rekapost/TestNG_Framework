pipeline {

  agent {
    docker {
      image 'abhishekf5/maven-abhishek-docker-agent:v1'                // pre-configured environment for building and testing Java applications using Maven
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock' // mount Docker socket to access the host's Docker daemon
    }
  }
  stages {

    stage('Clean') {
      steps {
        sh 'ls -ltr'
        sh 'TestNG-Framework && mvn clean'
      }
    }

    stage('Fix Permissions') {
      steps {
        echo 'Fixing permissions for Jenkins workspace files'
      }
    }

    stage('Clean Workspace') {
      steps {
        echo "Cleaning workspace"
      }
    }

    stage('Checkout') {
      steps {
        sh 'echo passed'
        git branch: 'master', url: 'https://github.com/Rekapost/TestNG_Framework.git'
      }
    }

    stage('Build and Test') {
      steps {
        sh 'ls -ltr'
        // build the project and create a JAR file
        sh 'TestNG-Framework && mvn clean package'
      }
    }

    stage('Build and Push Docker Image') {
      environment {
        DOCKER_IMAGE = "reka83/testng-framework:${BUILD_NUMBER}"
        REGISTRY_CREDENTIALS = credentials('docker-cred')
      }
      steps {
        script {
          sh 'TestNG-Framework && docker build -t ${DOCKER_IMAGE} .'
          def dockerImage = docker.image("${DOCKER_IMAGE}")
          docker.withRegistry('https://index.docker.io/v1/', "docker-cred") {
            dockerImage.push()
          }
        }
      }
    }

  }
}
