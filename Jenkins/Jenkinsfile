pipeline {
    agent {
    docker {
        image 'reka83/maven-chrome'
        args '-v /var/run/docker.sock:/var/run/docker.sock'  // Mount Docker socket
    }
}

    environment {
        DOCKER_REGISTRY = 'https://index.docker.io/v1/'
        DOCKER_USERNAME = 'reka83'
        // Set DOCKER_PASSWORD as a Jenkins secret (replace 'docker_password' with the correct credentials ID in Jenkins)
        DOCKER_PASSWORD = credentials('docker-cred') 
    }

    stages {
        stage('Login to Docker') {
            steps {
                script {
                    // Securely log in to Docker
                    sh 'echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin $DOCKER_REGISTRY'
                }
            }
        }
        
        stage('Checkout') {
            steps {
                echo 'Checkout Code'
                git branch: 'master', url: 'https://github.com/Rekapost/TestNG_Framework.git'
            }
        }

        stage('Build and Test') {
            steps {
                echo 'Running Maven tests'
                sh 'mvn clean test -Dsurefire.suiteXmlFiles=testng.xml'  // Run Maven tests
            }
        }
    }
}



