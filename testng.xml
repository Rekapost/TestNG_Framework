<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TestSuite" thread-count="4" parallel="classes">
    <listeners> 
        <listener class-name="utilities.Reporting"></listener>
    </listeners>

    <!-- LambdaTest Execution 
    <test name="ChromeTest_Lambda">
        <parameter name="browser" value="chrome" />
        <parameter name="isLambdaTest" value="true"/>
        <parameter name="isHeadless" value="true"/>
        <classes>
            <class name="testCases.TestCase"></class>
        </classes>
    </test>
	-->
    
    <!-- BrowserStack Execution -->
    <!-- Local Execution -->
    <test name="ChromeTest_Local"> 
        <parameter name="browser" value="chrome" />
        <parameter name="isLambdaTest" value="false"/>
        <parameter name="isHeadless" value="false"/>
        <classes>
            <class name="testCases.TestCase"></class>
            <class name="testCases.TestCaseDDT"></class> 
        </classes>
    </test>   
